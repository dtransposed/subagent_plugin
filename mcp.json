{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
      "local-code-search": {
        "type": "stdio",
        "command": "uv",
        "args": ["run", "search-subagent"],
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/venv",
          "UV_CACHE_DIR": "${PLUGIN_DATA}/uv-cache"
        },
        "cwd": "${PLUGIN_ROOT}"
      }
    }
  }